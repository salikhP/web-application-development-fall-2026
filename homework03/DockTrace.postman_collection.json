        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"status matches\", () => pm.expect(pm.response.json().status).to.equal(\"ok\"));"
            ]
          }
