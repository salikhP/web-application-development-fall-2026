      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Docker containers",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const containers = pm.response.json();",
              "const running = containers.filter(container => container.state === \"running\");",
              "const selected = running.find(container => container.name === \"homework03-backend-1\") || running[0];",
              "pm.test(\"A running Docker container is available\", () => pm.expect(selected).to.have.property(\"id\"));",
              "if (selected) pm.collectionVariables.set(\"containerId\", selected.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/containers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "containers"
          ]
        }
